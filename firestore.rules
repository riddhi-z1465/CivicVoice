rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Citizen User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Voter Information & Guidelines (Public Read, Admin Write)
    match /voter_information/{infoId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 3. Candidate Profiles (Public Read, Admin Write)
    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 4. Polling Booth Locations (Public Read, Admin Write)
    match /polling_booths/{boothId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 5. Civic Issue Reports
    match /civic_reports/{reportId} {
      // Any authenticated citizen can view reports in their area
      allow read: if isAuthenticated();
      
      // Citizens can only create reports tagged with their own user ID
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.title is string &&
                    request.resource.data.category is string;

      // Only the author or an administrative municipal officer can update
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.role == 'admin'
      );
      
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}
