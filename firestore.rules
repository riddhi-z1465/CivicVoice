rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // 1. Citizen & Authority User Profiles
    // users/{uid}: name, email, phone, role, createdAt
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Voter Information & Guidelines (Public Read, Authority Write)
    match /voter_information/{infoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Candidate Profiles (Public Read, Authority Write)
    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Polling Booth Locations (Public Read, Authority Write)
    match /polling_booths/{boothId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Civic Issue Reports
    // civic_reports/{reportId}: userId, title, category, description, location, imageUrl, status, createdAt, updatedAt
    match /civic_reports/{reportId} {
      // Citizens can read only their own reports; Admins can read all reports
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      // Citizens can only create reports tagged with their own user ID
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.title is string &&
                    request.resource.data.category is string;

      // Admins can manage report status and updates; citizens cannot modify administrative status
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'Submitted' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'statusHistory']))
      );
      
      allow delete: if isAdmin();
    }
  }
}
